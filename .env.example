JARVIS_PERSONA_MAX_WORDS_PROFESSIONAL=36
JARVIS_POLICY_DRY_RUN_MODE=false
JARVIS_RESPONSE_MODE_FEATURE_ENABLED=true
JARVIS_RESPONSE_SHAPER_ENABLED=true
JARVIS_SECOND_FACTOR_LOCKOUT_SECONDS=90
JARVIS_SECOND_FACTOR_MAX_ATTEMPTS_PER_TOKEN=3
JARVIS_STREAM_AR_HARD_FLUSH_CHARS=80
JARVIS_STREAM_AR_SOFT_FLUSH_CHARS=40
JARVIS_STT_LANGUAGE_HINT=auto
JARVIS_STT_PARTIAL_INTERVAL_SECONDS=0.35
